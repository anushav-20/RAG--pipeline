{
  "name": "ragpipe",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "python -m uvicorn ragpipe.api:app --reload --port 8000",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
